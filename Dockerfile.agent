FROM golang:1.27 AS agent-builder

# Upstream Go does not support the Red Hat host-dependent fips140=auto setting.
ENV GOTOOLCHAIN=local

WORKDIR /workspace

COPY go.mod go.sum ./
COPY pkg/tracing/go.mod pkg/tracing/go.sum ./pkg/tracing/
RUN go mod download

COPY cmd/validation-agent/ cmd/validation-agent/
COPY internal/ internal/
COPY api/ api/
COPY pkg/ pkg/

# Ordinary community images retain upstream Go's non-FIPS default.
# Declare build arguments in the consuming stage for Buildah compatibility.
ARG TARGETOS
ARG TARGETARCH
ARG GOFIPS140=off
ENV GOFIPS140=${GOFIPS140}
RUN CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -a -o validation-agent cmd/validation-agent/main.go

FROM gcr.io/distroless/static:nonroot

WORKDIR /

COPY --from=agent-builder /workspace/validation-agent /usr/local/bin/

USER 65532:65532

ENTRYPOINT ["/usr/local/bin/validation-agent"]
